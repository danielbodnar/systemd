# Rendered by systemd-migration: healthcheck of service web_app, run by web_app-health.timer

[Unit]
Description=healthcheck for web_app
After=web_app.service
BindsTo=web_app.service
OnFailure=web_app-restart.service

[Service]
Type=oneshot
Slice=stack-web.slice
RootMStack=/var/lib/machines/acme-app_2026.09.mstack
MountAPIVFS=yes
PrivateUsers=self
User=1000
Group=1000
CapabilityBoundingSet=
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectProc=invisible
ExecStart=/bin/sh -c "for i in $(seq 3); do if ( curl -fsS http://localhost:8080/healthz || exit 1 ); then exit 0; fi; sleep 1; done; exit 1"
TimeoutStartSec=18
SyslogIdentifier=web_app-health

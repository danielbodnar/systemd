# Rendered by systemd-service from swarm service data_exporter (stack data, mode replicated)
# The image is the service's root; see the [X-Migration] section for its origin.

[Unit]
Description=data_exporter (migrated from Docker Swarm stack data)
PartOf=data.target
After=network-online.target
Wants=network-online.target
ConditionHost=swarm-wrk-1

[Service]
Type=exec
RootMStack=/var/lib/machines/prometheuscommunity-postgres-exporter_v0.15.0.mstack
MountAPIVFS=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectProc=invisible
ProtectKernelTunables=yes
PrivateUsers=self
ExecStart=/bin/false
DynamicUser=yes
Environment=DATA_SOURCE_PASS_FILE=/run/secrets/postgres_password
Environment=DATA_SOURCE_URI=postgres:5432/app?sslmode=disable
Environment=DATA_SOURCE_USER=app
CapabilityBoundingSet=
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
Restart=always
RestartSec=5
KillMode=mixed
LoadCredentialEncrypted=data_postgres_password:/etc/credstore.encrypted/data_postgres_password
BindReadOnlyPaths=%d/data_postgres_password:/run/secrets/postgres_password
Slice=stack-data.slice
MemoryMax=128M
SocketBindAllow=tcp:9187
SocketBindDeny=any
SyslogIdentifier=data_exporter
LogExtraFields=SWARM_STACK=data SWARM_SERVICE=data_exporter

[X-Migration]
Source=docker-swarm
Stack=data
Service=data_exporter
Image=quay.io/prometheuscommunity/postgres-exporter:v0.15.0
ImageName=prometheuscommunity-postgres-exporter_v0.15.0
Renderer=systemd-service
Form=service

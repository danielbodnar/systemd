# Rendered by docker-image-to-service from swarm volume data_backups (driver local, type nfs)

[Unit]
Description=data_backups (swarm volume, nfs)
After=network-online.target
Wants=network-online.target

[Mount]
What=10.0.0.50:/exports/backups
Where=/var/lib/data/data_backups
Type=nfs
Options=rw,nfsvers=4

[Install]
WantedBy=data.target

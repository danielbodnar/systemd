# /etc/swarm-agent/worker.env
# Only non-secret settings belong here; the environment key is a systemd
# credential (LoadCredentialEncrypted= in the unit).
ANTHROPIC_ENVIRONMENT_ID=env_replace_me
# Optional: set when the API host differs (Claude Platform on AWS, a proxy).
#ANTHROPIC_BASE_URL=https://api.anthropic.com
# Optional: where the auditor's capture finds the swarm. The worker user is
# not in the docker group, so point this at a read-only proxy that exposes
# only GET requests on the manager socket (for example a docker-socket-proxy
# container with POST=0 and the info, nodes, services, tasks, networks,
# volumes, secrets, configs, and version sections enabled). Leave it unset to
# have the operator run capture.sh and copy the directory into the workspace.
#DOCKER_HOST=tcp://127.0.0.1:2375

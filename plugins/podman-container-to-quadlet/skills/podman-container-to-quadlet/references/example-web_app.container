# Rendered by podman-container-to-quadlet from swarm service web_app (stack web, mode replicated)
# Source inventory captured 2026-09-01T12:00:00Z

[Unit]
Description=web_app (migrated from Docker Swarm)
Wants=network-online.target
After=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=120

[Container]
Image=registry.example.com/acme/app:2026.09
ContainerName=web_app
Exec=serve --port 8080
User=1000:1000
WorkingDir=/srv/app
Secret=web_app-app-secret-key,type=env,target=APP_SECRET_KEY
Environment=DATABASE_URL=postgres://app@data_postgres:5432/app
Environment=LOG_LEVEL=info
Label=io.systemd-dev-plugins.service=web_app
Label=io.systemd-dev-plugins.stack=web
Network=web_frontend.network
Network=data_backend.network
NetworkAlias=app
PublishPort=8080:8080
Tmpfs=/tmp:size=67108864
Secret=web_app_signing_key,type=mount,target=signing_key,uid=1000,gid=1000,mode=0400
HealthCmd=curl -fsS http://localhost:8080/healthz || exit 1
HealthInterval=15s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=20s
HealthOnFailure=kill
Notify=healthy
AddHost=legacy.internal:10.0.9.9
DropCapability=all
Sysctl=net.core.somaxconn=1024
Ulimit=nofile=65536:65536
ReadOnly=true
RunInit=true
StopSignal=SIGTERM
StopTimeout=30
LogDriver=journald
PidsLimit=512

[Service]
Restart=on-failure
RestartSec=3
TimeoutStartSec=900
CPUQuota=150%
MemoryMax=536870912
MemoryLow=134217728
CPUWeight=25
TasksMax=512

[Install]
WantedBy=multi-user.target web.target

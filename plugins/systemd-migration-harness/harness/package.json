{
  "name": "swarm-agent",
  "version": "0.1.0",
  "description": "Managed Agents harness for the systemd-dev-plugins migration skills: moves Docker Swarm estates onto systemd-native hosts: config-as-code applied with the ant CLI, a self-hosted worker for production hosts, and an operator CLI that drives sessions with an approval policy.",
  "type": "module",
  "license": "LGPL-2.1-or-later",
  "private": true,
  "bin": {
    "swarm-agent": "./src/cli.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "lint": "cd ../.. && systemd-migration-harness/harness/node_modules/.bin/oxlint systemd-migration-harness/harness/src systemd-migration-harness/harness/test docker-swarm-to-systemd/contract docker-swarm-to-systemd/skills/docker-swarm-to-inventory/scripts docker-swarm-to-systemd/skills/docker-to-systemd-planner/scripts oci-image-to-systemd/skills/docker-image-to-service/scripts podman-container-to-quadlet/skills/podman-container-to-quadlet/scripts",
    "cli": "bun run src/cli.ts"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "overrides": {
    "fast-sha256": "file:./vendor/fast-sha256"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "fast-sha256": "file:./vendor/fast-sha256",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "oxlint": "1.62.0",
    "typescript": "^5.9.0"
  }
}

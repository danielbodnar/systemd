#
# Tool executor for the systemd-migration-harness plugin. This is the process that
# runs the agents' bash and file tools, and it is deliberately not the process
# that holds the environment key: it runs as its own user, swarm-agent-tools,
# loads no credential, and cannot read the worker's credentials directory
# (mode 0700, owned by swarm-agent). The worker forwards each tool call over
# the Unix socket in /run/swarm-agent/ and gets the result back; nothing an
# approved command can do here reaches a secret.
#
# The two users share the swarm-agent group: the workspace and /mnt/memory are
# group-writable with the setgid bit so files either side creates stay usable
# by the other.

[Unit]
Description=swarm-agent tool executor (no credentials)
Documentation=https://platform.claude.com/docs/en/managed-agents/self-hosted-sandboxes
After=network-online.target
Wants=network-online.target
PartOf=swarm-agent-worker.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=swarm-agent-tools
# The primary group owns the runtime directory, the socket, and the token
# file; only the worker is a member besides the executor itself. The shared
# workspace group is supplementary (its setgid bit keeps files in it).
Group=swarm-agent-ipc
SupplementaryGroups=swarm-agent
Slice=swarm-agent.slice
WorkingDirectory=/opt/swarm-agent/harness
ExecStart=/usr/local/bin/bun run src/cli.ts tools --config /etc/swarm-agent/swarm-agent.yaml
EnvironmentFile=-/etc/swarm-agent/worker.env
Environment=HOME=/var/lib/swarm-agent/workspace
RuntimeDirectory=swarm-agent
RuntimeDirectoryMode=0750
UMask=0007
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/swarm-agent/workspace /mnt/memory
# Bash runs inside this sandbox: the host is read-only apart from the two
# paths above, and the secret and credential directories do not exist from
# its point of view.
InaccessiblePaths=-/etc/swarm-migration/secrets -/etc/credstore -/etc/credstore.encrypted -/run/credentials
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Restart=on-failure
RestartSec=10s
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=90s

[Install]
WantedBy=multi-user.target

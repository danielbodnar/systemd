{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danielbodnar/systemd/plugins/docker-swarm-to-systemd/contract/inventory-schema.json",
  "title": "SwarmInventory",
  "description": "Normalized description of a Docker Swarm cluster produced by docker-swarm-to-inventory/scripts/normalize.ts and consumed by the podman-container-to-quadlet, docker-to-systemd-planner, and systemd-migration-verify skills.",
  "type": "object",
  "required": ["version", "captured_at", "cluster", "nodes", "stacks", "services", "networks", "volumes", "secrets", "configs", "warnings"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1" },
    "captured_at": { "type": "string", "format": "date-time" },
    "captured_on": { "type": "string" },
    "cluster": {
      "type": "object",
      "required": ["id", "engine_version", "managers", "workers", "is_leader"],
      "properties": {
        "id": { "type": "string" },
        "engine_version": { "type": "string" },
        "managers": { "type": "integer", "minimum": 0 },
        "workers": { "type": "integer", "minimum": 0 },
        "is_leader": { "type": "boolean" }
      }
    },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "stacks": { "type": "array", "items": { "$ref": "#/$defs/stack" } },
    "services": { "type": "array", "items": { "$ref": "#/$defs/service" } },
    "networks": { "type": "array", "items": { "$ref": "#/$defs/network" } },
    "volumes": { "type": "array", "items": { "$ref": "#/$defs/volume" } },
    "secrets": { "type": "array", "items": { "$ref": "#/$defs/secret" } },
    "configs": { "type": "array", "items": { "$ref": "#/$defs/config" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "duration": {
      "type": ["string", "null"],
      "description": "systemd-style duration such as 30s, 1m30s, or 500ms; null when Swarm had no value",
      "pattern": "^(\\d+(h|m|s|ms))+$"
    },
    "node": {
      "type": "object",
      "required": ["id", "hostname", "role", "leader", "availability", "state", "addr", "labels", "engine_labels", "engine_version", "os", "arch", "nano_cpus", "memory_bytes"],
      "properties": {
        "id": { "type": "string" },
        "hostname": { "type": "string" },
        "role": { "enum": ["manager", "worker"] },
        "leader": { "type": "boolean" },
        "availability": { "enum": ["active", "pause", "drain"] },
        "state": { "type": "string" },
        "addr": { "type": "string" },
        "labels": { "$ref": "#/$defs/stringMap" },
        "engine_labels": { "$ref": "#/$defs/stringMap" },
        "engine_version": { "type": "string" },
        "os": { "type": "string" },
        "arch": { "type": "string" },
        "nano_cpus": { "type": "integer" },
        "memory_bytes": { "type": "integer" }
      }
    },
    "stack": {
      "type": "object",
      "required": ["name", "services"],
      "properties": {
        "name": { "type": "string" },
        "services": { "type": "array", "items": { "type": "string" } }
      }
    },
    "port": {
      "type": "object",
      "required": ["target", "published", "protocol", "mode"],
      "properties": {
        "target": { "type": "integer" },
        "published": { "type": ["integer", "null"] },
        "protocol": { "enum": ["tcp", "udp", "sctp"] },
        "mode": { "enum": ["ingress", "host"] }
      }
    },
    "mount": {
      "type": "object",
      "required": ["type", "source", "target", "readonly"],
      "properties": {
        "type": { "enum": ["bind", "volume", "tmpfs", "npipe", "cluster"] },
        "source": { "type": ["string", "null"] },
        "target": { "type": "string" },
        "readonly": { "type": "boolean" },
        "volume_nocopy": { "type": "boolean" },
        "volume_driver": { "type": "string" },
        "volume_options": { "$ref": "#/$defs/stringMap" },
        "bind_propagation": { "type": "string" },
        "tmpfs_size_bytes": { "type": "integer" },
        "tmpfs_mode": { "type": "integer" }
      }
    },
    "fileRef": {
      "type": "object",
      "required": ["name", "id", "target", "uid", "gid", "mode"],
      "properties": {
        "name": { "type": "string" },
        "id": { "type": "string" },
        "target": { "type": "string", "description": "Path inside the container; Swarm mounts secrets under /run/secrets/ and configs where the spec says" },
        "uid": { "type": "string" },
        "gid": { "type": "string" },
        "mode": { "type": "integer" }
      }
    },
    "healthcheck": {
      "type": ["object", "null"],
      "required": ["test", "interval", "timeout", "retries", "start_period"],
      "properties": {
        "test": { "type": "array", "items": { "type": "string" }, "description": "Docker form: first element is CMD, CMD-SHELL, or NONE" },
        "interval": { "$ref": "#/$defs/duration" },
        "timeout": { "$ref": "#/$defs/duration" },
        "retries": { "type": ["integer", "null"] },
        "start_period": { "$ref": "#/$defs/duration" }
      }
    },
    "resourceSpec": {
      "type": "object",
      "required": ["nano_cpus", "memory_bytes", "pids"],
      "properties": {
        "nano_cpus": { "type": ["integer", "null"] },
        "memory_bytes": { "type": ["integer", "null"] },
        "pids": { "type": ["integer", "null"] }
      }
    },
    "updateConfig": {
      "type": ["object", "null"],
      "properties": {
        "parallelism": { "type": "integer" },
        "delay": { "$ref": "#/$defs/duration" },
        "failure_action": { "type": "string" },
        "monitor": { "$ref": "#/$defs/duration" },
        "max_failure_ratio": { "type": "number" },
        "order": { "type": "string" }
      }
    },
    "task": {
      "type": "object",
      "required": ["id", "node", "desired_state", "current_state", "error"],
      "properties": {
        "id": { "type": "string" },
        "node": { "type": "string", "description": "hostname of the node running the task" },
        "desired_state": { "type": "string" },
        "current_state": { "type": "string" },
        "error": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "required": ["id", "name", "short_name", "stack", "image", "image_digest", "command", "args", "env", "redacted_env", "labels", "container_labels", "mode", "replicas", "placement", "networks", "ports", "mounts", "secrets", "configs", "healthcheck", "resources", "restart_policy", "update_config", "rollback_config", "stop_grace_period", "stop_signal", "user", "workdir", "hostname", "dns", "extra_hosts", "cap_add", "cap_drop", "sysctls", "ulimits", "read_only", "init", "tty", "privileged", "logging", "endpoint_mode", "tasks"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "description": "Full Swarm service name, e.g. web_app" },
        "short_name": { "type": "string", "description": "Service name without the stack prefix, e.g. app" },
        "stack": { "type": ["string", "null"] },
        "image": { "type": "string" },
        "image_digest": { "type": ["string", "null"] },
        "command": { "type": "array", "items": { "type": "string" }, "description": "Overrides the image ENTRYPOINT" },
        "args": { "type": "array", "items": { "type": "string" }, "description": "Overrides the image CMD" },
        "env": { "$ref": "#/$defs/stringMap" },
        "redacted_env": { "type": "array", "items": { "type": "string" } },
        "labels": { "$ref": "#/$defs/stringMap" },
        "container_labels": { "$ref": "#/$defs/stringMap" },
        "mode": { "enum": ["replicated", "global", "replicated-job", "global-job"] },
        "replicas": { "type": ["integer", "null"] },
        "placement": {
          "type": "object",
          "required": ["constraints", "preferences", "max_replicas_per_node", "platforms"],
          "properties": {
            "constraints": { "type": "array", "items": { "type": "string" } },
            "preferences": { "type": "array", "items": { "type": "string" } },
            "max_replicas_per_node": { "type": ["integer", "null"] },
            "platforms": { "type": "array", "items": { "type": "string" } }
          }
        },
        "networks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "aliases"],
            "properties": {
              "name": { "type": "string", "description": "Network id or name as referenced by the service spec" },
              "aliases": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "mounts": { "type": "array", "items": { "$ref": "#/$defs/mount" } },
        "secrets": { "type": "array", "items": { "$ref": "#/$defs/fileRef" } },
        "configs": { "type": "array", "items": { "$ref": "#/$defs/fileRef" } },
        "healthcheck": { "$ref": "#/$defs/healthcheck" },
        "resources": {
          "type": "object",
          "required": ["limits", "reservations"],
          "properties": {
            "limits": { "$ref": "#/$defs/resourceSpec" },
            "reservations": { "$ref": "#/$defs/resourceSpec" }
          }
        },
        "restart_policy": {
          "type": "object",
          "required": ["condition", "delay", "max_attempts", "window"],
          "properties": {
            "condition": { "enum": ["none", "on-failure", "any"] },
            "delay": { "$ref": "#/$defs/duration" },
            "max_attempts": { "type": ["integer", "null"] },
            "window": { "$ref": "#/$defs/duration" }
          }
        },
        "update_config": { "$ref": "#/$defs/updateConfig" },
        "rollback_config": { "$ref": "#/$defs/updateConfig" },
        "stop_grace_period": { "$ref": "#/$defs/duration" },
        "stop_signal": { "type": ["string", "null"] },
        "user": { "type": ["string", "null"] },
        "workdir": { "type": ["string", "null"] },
        "hostname": { "type": ["string", "null"] },
        "dns": {
          "type": "object",
          "required": ["nameservers", "search", "options"],
          "properties": {
            "nameservers": { "type": "array", "items": { "type": "string" } },
            "search": { "type": "array", "items": { "type": "string" } },
            "options": { "type": "array", "items": { "type": "string" } }
          }
        },
        "extra_hosts": { "type": "array", "items": { "type": "string" } },
        "cap_add": { "type": "array", "items": { "type": "string" } },
        "cap_drop": { "type": "array", "items": { "type": "string" } },
        "sysctls": { "$ref": "#/$defs/stringMap" },
        "ulimits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "soft", "hard"],
            "properties": {
              "name": { "type": "string" },
              "soft": { "type": "integer" },
              "hard": { "type": "integer" }
            }
          }
        },
        "read_only": { "type": "boolean" },
        "init": { "type": "boolean" },
        "tty": { "type": "boolean" },
        "privileged": { "type": "boolean" },
        "logging": {
          "type": "object",
          "required": ["driver", "options"],
          "properties": {
            "driver": { "type": ["string", "null"] },
            "options": { "$ref": "#/$defs/stringMap" }
          }
        },
        "endpoint_mode": { "enum": ["vip", "dnsrr"] },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } }
      }
    },
    "network": {
      "type": "object",
      "required": ["id", "name", "driver", "scope", "ingress", "internal", "attachable", "encrypted", "ipv6", "ipam", "options", "labels", "stack", "used_by"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "driver": { "type": "string" },
        "scope": { "type": "string" },
        "ingress": { "type": "boolean" },
        "internal": { "type": "boolean" },
        "attachable": { "type": "boolean" },
        "encrypted": { "type": "boolean" },
        "ipv6": { "type": "boolean" },
        "ipam": {
          "type": "object",
          "required": ["driver", "config"],
          "properties": {
            "driver": { "type": "string" },
            "config": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "subnet": { "type": "string" },
                  "gateway": { "type": "string" },
                  "ip_range": { "type": "string" }
                }
              }
            }
          }
        },
        "options": { "$ref": "#/$defs/stringMap" },
        "labels": { "$ref": "#/$defs/stringMap" },
        "stack": { "type": ["string", "null"] },
        "used_by": { "type": "array", "items": { "type": "string" } }
      }
    },
    "volume": {
      "type": "object",
      "required": ["name", "driver", "scope", "mountpoint", "options", "labels", "stack", "used_by"],
      "properties": {
        "name": { "type": "string" },
        "driver": { "type": "string" },
        "scope": { "type": "string" },
        "mountpoint": { "type": ["string", "null"] },
        "options": { "$ref": "#/$defs/stringMap" },
        "labels": { "$ref": "#/$defs/stringMap" },
        "stack": { "type": ["string", "null"] },
        "used_by": { "type": "array", "items": { "type": "string" } }
      }
    },
    "secret": {
      "type": "object",
      "required": ["id", "name", "labels", "created_at", "stack", "used_by"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "labels": { "$ref": "#/$defs/stringMap" },
        "created_at": { "type": "string" },
        "stack": { "type": ["string", "null"] },
        "used_by": { "type": "array", "items": { "type": "string" } }
      }
    },
    "config": {
      "type": "object",
      "required": ["id", "name", "labels", "created_at", "data_base64", "stack", "used_by"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "labels": { "$ref": "#/$defs/stringMap" },
        "created_at": { "type": "string" },
        "data_base64": { "type": ["string", "null"] },
        "stack": { "type": ["string", "null"] },
        "used_by": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
